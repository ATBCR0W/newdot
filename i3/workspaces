#####################
# workspace layout: #
#####################

workspace_layout default

##########################################
# configuration for workspace behaviour: #
##########################################

set $ws1  "1:BATMAN"
set $ws2  "2:PUTER"
set $ws3  "3:BAT-BOX"
set $ws4  "4:BATCAVE"
set $ws5  "5:ORACLE"
set $ws6  "6:ARKHAM"
set $ws7  "7:GOTHAM"
set $ws8  "8:CLAYFACE"
set $ws9  "9:JOKER"
set $ws10 "10:ALFRED"


# bind program to workspace and focus to them on startup:
# NOTE: kitty is intentionally NOT assigned here - it's used across
# multiple workspaces (CODE, FILES, MAIN, etc), so pinning it to one
# would drag every kitty window there. Open it manually per workspace.

#assign [class="(?i)zen"]            $ws1
assign [class="discord"]            $ws5
assign [class="Thunar"]             $ws4
assign [class="Steam"]               $ws6
#assign [class="virt-manager"]       $ws8
assign [class="obsidian"]           $ws9

# automatic set focus new window if it opens on another workspace than the current:
for_window [class="(?i)zen"]       focus
for_window [class="discord"]       focus
for_window [class="Thunar"]        focus
for_window [class="Steam"]              focus
for_window [class="virt-manager"]  focus
